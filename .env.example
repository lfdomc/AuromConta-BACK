# --- Supabase ---
# Cadena del pooler en modo sesión (Settings > Database > Connection string > Session pooler)
DATABASE_URL=postgresql://postgres.<proyecto>:<clave>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<proyecto>.supabase.co
# Solo si el proyecto usa el secreto JWT antiguo (HS256). Proyectos nuevos usan JWKS automáticamente.
SUPABASE_JWT_SECRET=
# Solo para enviar invitaciones a usuarios (nunca se usa para leer datos).
# Llave "secret" nueva (sb_secret_...): Project Settings > API Keys > Secret keys.
# (Se acepta también SUPABASE_SERVICE_ROLE_KEY con la service_role antigua, que se retira a fines de 2026.)
SUPABASE_SECRET_KEY=
# --- Aplicación ---
APP_URL=https://conta.auromtec.com
API_URL=https://<servicio>.up.railway.app
CORS_ORIGINS=https://conta.auromtec.com
ENTORNO=produccion
CRON_SECRET=<cadena larga aleatoria>
# --- Correo (Resend) ---
RESEND_API_KEY=
CORREO_REMITENTE=Planilla Costa Rica <planilla@auromtec.com>
# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=<cadena aleatoria>
TELEGRAM_CHAT_DUENA=
# --- Tilopay ---
TILOPAY_API_URL=https://app.tilopay.com/api/v1
TILOPAY_API_KEY=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_WEBHOOK_SECRET=<cadena aleatoria>
# --- Hacienda (factura electrónica 4.4) ---
HACIENDA_AMBIENTE=pruebas
HACIENDA_USUARIO=
HACIENDA_CLAVE=
HACIENDA_P12_BASE64=
HACIENDA_P12_PIN=
HACIENDA_CALLBACK_URL=
# --- Seguridad ---
# Segundo factor obligatorio para aprobar, cerrar, autorizar salarios, administrar y plataforma
MFA_OBLIGATORIA=si
# 32 bytes aleatorios en base64:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CLAVE_CIFRADO=
CLAVE_CIFRADO_ANTERIOR=
HOSTS_PERMITIDOS=<servicio>.up.railway.app,api.auromtec.com
DOCUMENTACION_PUBLICA=no
LIMITE_POR_MINUTO=300
LIMITE_SENSIBLE_POR_MINUTO=30
DB_STATEMENT_TIMEOUT_MS=20000
